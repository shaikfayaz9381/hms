# MedPulse Hospital Management System - Environment Configuration
# Copy this file to .env and configure with your credentials:
# cp .env.example .env

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secret (Used for signing JSON Web Tokens)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# For Supabase: Project Settings > Database > Connection string (URI)
# Pooled Connection (Transaction Mode, Port 6543) - Recommended for API runtime:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Session / Direct Mode, Port 5432) - Required for Prisma Migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Local PostgreSQL fallback URI for offline testing
# LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospital_db"
